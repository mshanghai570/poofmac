# PoofMac — Configuration
# Copy to .env and set ACTIVE_PROVIDER, or leave it at auto for legacy priority.
# First sign-in for GitHub Copilot / OpenAI Codex uses LiteLLM OAuth device flow.

# Provider: auto, anthropic, openrouter, openai, openai_compat,
#           github_copilot, openai_codex, ollama_cloud, ollama_local
ACTIVE_PROVIDER=auto

# Cloud API keys (optional)
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# OpenAI-compatible endpoint (for example vLLM, LM Studio, Ollama /v1, Groq).
# The GUI and main model selector can fetch model IDs from its /models endpoint.
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=

# Subscription-backed model IDs
GITHUB_COPILOT_MODEL=gpt-5.2
OPENAI_CODEX_MODEL=gpt-5.3-codex

# Model preferences for API-key and Ollama providers
PREFERRED_CLOUD_MODEL=claude-sonnet-4-6
PREFERRED_LOCAL_MODEL=qwen2.5:14b
OLLAMA_API_KEY=

# Safety: true scans only and disables deletion.
SAFE_MODE=false
