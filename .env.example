# PoofMac — Configuration
#
# You normally never edit this by hand: Settings → Providers has a page per
# provider, and Save writes these keys for you.
#
# Where this file lives:
#   • .env in the directory you launch PoofMac from, if one exists, else
#   • ~/Library/Application Support/PoofMac/.env   (macOS)
#   • $XDG_CONFIG_HOME/poofmac/.env                (Linux)
# The same directory holds endpoints.json — your custom OpenAI-compatible
# endpoints, managed from Settings → Providers → Custom endpoints.
# Override the path with POOFMAC_ENV_FILE=/some/other/.env
#
# ACTIVE_PROVIDER=auto picks the first provider that is fully configured, in
# the order listed below. Set it to a provider id to pin that one. Custom
# endpoints use "custom:<endpoint id>" and live in endpoints.json.

# One of: auto, github_copilot, openai_codex, openai_compat,
#         anthropic, openrouter, openai, ollama_cloud, ollama_local
ACTIVE_PROVIDER=auto

# ── Subscription providers ────────────────────────────────────────────────────
# No API key. Sign in once from Settings → Providers, or run `copilot login`
# / `codex login`. PoofMac reuses those saved credentials.
GITHUB_COPILOT_MODEL=gpt-5.2
OPENAI_CODEX_MODEL=gpt-5.3-codex

# ── Cloud APIs ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

OPENROUTER_API_KEY=
OPENROUTER_MODEL=

OPENAI_API_KEY=
OPENAI_MODEL=

# ── Custom OpenAI-compatible endpoints ────────────────────────────────────────
# vLLM, LM Studio, llama.cpp, Ollama /v1, Groq, DeepSeek, an OpenAI proxy …
# These live in endpoints.json next to this file — one record per endpoint
# (name, base_url, api_key, model, models) — added and edited under
# Settings → Providers → Custom endpoints, which is also where Fetch models
# fills in the ids each endpoint hosts.
#
# These three legacy keys are still read once, when no endpoints.json exists
# yet, and imported into it:
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=

# ── Ollama ────────────────────────────────────────────────────────────────────
OLLAMA_API_KEY=
OLLAMA_CLOUD_MODEL=
OLLAMA_LOCAL_MODEL=qwen2.5:14b

# ── Safety ────────────────────────────────────────────────────────────────────
# true scans and reports only; no file can be deleted.
SAFE_MODE=false

# Legacy: still read when a provider's own *_MODEL key above is empty.
PREFERRED_CLOUD_MODEL=claude-sonnet-4-6
PREFERRED_LOCAL_MODEL=qwen2.5:14b
